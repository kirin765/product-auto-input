NODE_ENV=production
HOST=127.0.0.1
PORT=3022
APP_BASE_URL=https://product-auto-input.onnurimun.com
DB_PATH=/opt/apps/product-auto-input/data/app.sqlite
DEV_LOG_EMAIL=false

PADDLE_ENV=live
PADDLE_API_KEY=replace_with_server_api_key
PADDLE_PRICE_ID=replace_with_price_id
PADDLE_WEBHOOK_SECRET=replace_with_webhook_secret
PADDLE_CLIENT_TOKEN=replace_with_public_paddle_js_token

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_app_password
SMTP_FROM=support@onnurimun.com
