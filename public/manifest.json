{
  "manifest_version": 3,
  "name": "상품 등록 도우미 — Product Auto Input",
  "version": "0.2.0",
  "description": "CSV·XLSX·JSON으로 준비한 상품 정보를 지원 판매자센터의 등록 폼에 채워 줍니다. 입력 결과를 확인하고 저장·제출은 직접 진행하세요.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "상품 등록 도우미",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sell.smartstore.naver.com/*",
        "https://wing.coupang.com/*",
        "https://soffice.11st.co.kr/*",
        "https://partner.zigzag.kr/*",
        "https://my.a-bly.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.esmplus.com/*",
        "https://item.esmplus.com/*",
        "https://seller-admin.a-bly.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://sell.smartstore.naver.com/*",
    "https://wing.coupang.com/*",
    "https://soffice.11st.co.kr/*",
    "https://partner.zigzag.kr/*",
    "https://my.a-bly.com/*",
    "https://seller-admin.a-bly.com/*",
    "https://www.esmplus.com/*",
    "https://item.esmplus.com/*",
    "https://product-auto-input.onnurimun.com/*"
  ],
  "homepage_url": "https://product-auto-input.onnurimun.com"
}
